#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/josepuma/Documents/Github/animate-editor-sb/node_modules/.pnpm/@electron+packager@18.4.4/node_modules/@electron/packager/node_modules:/Users/josepuma/Documents/Github/animate-editor-sb/node_modules/.pnpm/@electron+packager@18.4.4/node_modules:/Users/josepuma/Documents/Github/animate-editor-sb/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/josepuma/Documents/Github/animate-editor-sb/node_modules/.pnpm/@electron+packager@18.4.4/node_modules/@electron/packager/node_modules:/Users/josepuma/Documents/Github/animate-editor-sb/node_modules/.pnpm/@electron+packager@18.4.4/node_modules:/Users/josepuma/Documents/Github/animate-editor-sb/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@electron/packager/bin/electron-packager.js" "$@"
else
  exec node  "$basedir/../@electron/packager/bin/electron-packager.js" "$@"
fi
