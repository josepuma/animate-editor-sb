#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/josepuma/Documents/Github/animate-editor-sb/node_modules/.pnpm/nuxt@4.4.6_@babel+plugin-syntax-jsx@7.28.6_@babel+core@7.29.0__@babel+plugin-syntax-typ_43aa6f91f7b0bec475345943ec5eccf2/node_modules/nuxt/node_modules:/Users/josepuma/Documents/Github/animate-editor-sb/node_modules/.pnpm/nuxt@4.4.6_@babel+plugin-syntax-jsx@7.28.6_@babel+core@7.29.0__@babel+plugin-syntax-typ_43aa6f91f7b0bec475345943ec5eccf2/node_modules:/Users/josepuma/Documents/Github/animate-editor-sb/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/josepuma/Documents/Github/animate-editor-sb/node_modules/.pnpm/nuxt@4.4.6_@babel+plugin-syntax-jsx@7.28.6_@babel+core@7.29.0__@babel+plugin-syntax-typ_43aa6f91f7b0bec475345943ec5eccf2/node_modules/nuxt/node_modules:/Users/josepuma/Documents/Github/animate-editor-sb/node_modules/.pnpm/nuxt@4.4.6_@babel+plugin-syntax-jsx@7.28.6_@babel+core@7.29.0__@babel+plugin-syntax-typ_43aa6f91f7b0bec475345943ec5eccf2/node_modules:/Users/josepuma/Documents/Github/animate-editor-sb/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../nuxt/bin/nuxt.mjs" "$@"
else
  exec node  "$basedir/../nuxt/bin/nuxt.mjs" "$@"
fi
